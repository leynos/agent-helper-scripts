{
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 260,
      "code_block_line_length": 260,
      "tables": false,
      "headings": false
    },
    "MD024": { "siblings_only": true },
    "MD029": { "style": "ordered" },
    "MD033": false,
    "MD036": false,
    "MD040": false,
    "MD041": false
  },
  "ignores": [
    "**/.venv/**",
    ".node_modules/**",
    "**/node_modules/**",
    "**/target/**",
    ".terraform/**",
    ".uv-cache/**",
    ".uv-tools/**",
    "CRUSH.md"
  ]
}
