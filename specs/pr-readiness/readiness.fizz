# Behavioural specification of the pr-babysitting draft-to-ready protocol.
#
# The skill is the normative contract; this file is the executable
# specification of the obligations listed in obligations.toml. It models four
# separate layers and never lets one stand in for another:
#
#   authority   - the accepted assignment (`cfg`): applicability, authority,
#                 and whether the layer implements the whole approved plan.
#   reality     - the remote PR, the approved plan revision, the proof
#                 inventory, the checks and the discussion thread.
#   observation - what the agent has read (`obs`, `cur`, `intent`); lost on
#                 interruption.
#   evidence    - the durable delivery ledger (`l_*`), which survives it.
#
# Every action is atomic and stands for one externally visible step, so the
# environment can act between any two agent steps. Nothing gives the agent
# knowledge of a change it has not read.

KINDS = ("completeness", "proof")
TERMINAL = ("done", "impasse")

# Each reply shape is what the assessment service may say about one request.
# `sound-clear` is the only shape that clears; every other shape is a way a
# reply can look favourable without establishing what the gate asks. `rev`
# says whether the reply echoes the revision it was asked about, omits it,
# or names an earlier one.
SHAPES = {
    "sound-clear": record(verdict="clear", subject="whole", cand=True, rev="echoed", proofs="all"),
    "subset-clear": record(verdict="clear", subject="subset", cand=True, rev="echoed", proofs="all"),
    "other-subject": record(verdict="clear", subject="other", cand=True, rev="echoed", proofs="all"),
    "partial-proofs": record(verdict="clear", subject="whole", cand=True, rev="echoed", proofs="first"),
    "no-proofs": record(verdict="clear", subject="whole", cand=True, rev="echoed", proofs="none"),
    "no-revision-echo": record(verdict="clear", subject="whole", cand=True, rev="absent", proofs="all"),
    "superseded-revision-echo": record(verdict="clear", subject="whole", cand=True, rev="superseded", proofs="all"),
    "other-candidate": record(verdict="clear", subject="whole", cand=False, rev="echoed", proofs="all"),
    "not-applicable-claim": record(verdict="not-applicable", subject="whole", cand=True, rev="echoed", proofs="all"),
    "not-clear": record(verdict="not-clear", subject="whole", cand=True, rev="echoed", proofs="all"),
    "acknowledgement": record(verdict="unrecognized", subject="whole", cand=True, rev="echoed", proofs="all"),
}


def scenario(
    completeness_applies=True,
    proof_applies=False,
    has_plan=True,
    na_justified=True,
    proofs=(),
    wider_proofs=None,
    authority="merge",
    whole_plan=True,
    change_budget=0,
    env_head=False,
    env_base=False,
    env_plan=False,
    env_inventory=False,
    reply_shapes=("sound-clear",),
    env_foreign=False,
    env_edits=False,
    ci_outcomes=("green",),
    hosted_outcomes=("clear",),
    local_outcomes=("clear",),
    outage_budget=0,
    outage_recovers=True,
    starts_in_outage=False,
    starts_ready=False,
    crash_budget=0,
    seed_requests=(),
    seed_replies=(),
    expect_ready="reachable",
    expect_merge="reachable",
    expect_recovery="unchecked",
    expect_stale_ready="unchecked",
    expect_reentry="unchecked",
    expect_progress="unchecked",
    check_strong=False,
    name="default"):
    """Return one accepted assignment with its environment and expectations."""
    return record(
        completeness_applies=completeness_applies, proof_applies=proof_applies,
        has_plan=has_plan, na_justified=na_justified, proofs=proofs,
        wider_proofs=wider_proofs, authority=authority, whole_plan=whole_plan,
        change_budget=change_budget, env_head=env_head, env_base=env_base,
        env_plan=env_plan, env_inventory=env_inventory,
        reply_shapes=reply_shapes, env_foreign=env_foreign,
        env_edits=env_edits, ci_outcomes=ci_outcomes,
        hosted_outcomes=hosted_outcomes, local_outcomes=local_outcomes,
        outage_budget=outage_budget, outage_recovers=outage_recovers,
        starts_in_outage=starts_in_outage, starts_ready=starts_ready,
        crash_budget=crash_budget,
        seed_requests=seed_requests, seed_replies=seed_replies,
        expect_ready=expect_ready, expect_merge=expect_merge,
        expect_recovery=expect_recovery,
        expect_stale_ready=expect_stale_ready, expect_reentry=expect_reentry,
        expect_progress=expect_progress, check_strong=check_strong, name=name)


# A configuration replaces this list through --preinit-hook-file. More than
# one entry makes Init choose among them, which is how a snapshot table is
# checked in a single run.
SCENARIOS = [scenario()]


def applies(cfg, kind):
    """Applicability comes from the accepted assignment, never from a reply."""
    if kind == "completeness":
        return cfg.completeness_applies
    return cfg.proof_applies


def question(kind, base, head, rev, proofs):
    """Return the semantic identity of one assessment question.

    The proof inventory belongs only to the proof question; the plan revision
    belongs to both whenever an ExecPlan applies.
    """
    asked = ()
    if kind == "proof":
        asked = proofs
    return record(kind=kind, base=base, head=head, rev=rev, proofs=asked)


def same_question(request, wanted):
    return (request.kind == wanted.kind and request.base == wanted.base
            and request.head == wanted.head and request.rev == wanted.rev
            and request.proofs == wanted.proofs)


def find_request(requests, wanted):
    """Return the marker of the request already asking `wanted`, or None."""
    for marker in range(len(requests)):
        if same_question(requests[marker], wanted):
            return marker
    return None


def shaped_reply(request, shape_name):
    """Return what the service says about `request` when it takes this shape."""
    shape = SHAPES[shape_name]
    head = request.head
    if not shape.cand:
        head = request.head + 100
    rev = request.rev
    if shape.rev == "absent":
        rev = None
    if shape.rev == "superseded":
        # The reply names an earlier revision than the one it was asked about.
        rev = request.rev - 100
    proofs = request.proofs
    if shape.proofs == "first":
        proofs = request.proofs[:1]
    if shape.proofs == "none":
        proofs = ()
    return record(verdict=shape.verdict, subject=shape.subject,
                  base=request.base, head=head, rev=rev, proofs=proofs,
                  shape=shape_name, edits=0)


def shape_allowed(cfg, request, shape_name):
    """An honest service clears the whole plan only when it is implemented.

    Whether a verdict is justified is the assessor's decision and outside this
    model; the one constraint taken from the contract is that a layer holding
    part of an undivided plan cannot truthfully be given a whole-plan verdict.
    Proof-only shapes are meaningless for a completeness question.
    """
    if request.kind == "completeness":
        if shape_name in ("partial-proofs", "no-proofs"):
            return False
        if shape_name == "sound-clear" and not cfg.whole_plan:
            return False
    if request.kind == "proof":
        if shape_name in ("subset-clear", "other-subject"):
            return False
        if shape_name == "partial-proofs" and len(request.proofs) < 2:
            return False
    if shape_name in ("no-revision-echo", "superseded-revision-echo") and request.rev == None:
        return False
    return True


def covers(required, answered):
    """The documented coverage relation: every required proof is answered.

    Order and extra entries are irrelevant, so this is neither list equality
    nor order-sensitive.
    """
    for proof in required:
        if proof not in answered:
            return False
    return True


def seeded_thread(kind, spec, has_plan, proofs):
    """Return the request and reply one snapshot's thread holds for `kind`.

    `spec` is `none`, or `<request>:<reply>`. The request is `current`, or
    one asked about a `superseded-revision` or about `another-candidate`;
    identities only increase from zero, so the stand-in value -1 can never
    be mistaken for the candidate in force. The reply is a shape name, or
    `none` for a question nobody has answered.
    """
    if spec == "none":
        return None
    parts = spec.split(":")
    rev = 0 if has_plan else None
    head = 0
    if parts[0] == "superseded-revision":
        rev = -1
    if parts[0] == "another-candidate":
        head = -1
    request = question(kind, 0, head, rev, proofs)
    reply = None
    if parts[1] != "none":
        reply = shaped_reply(request, parts[1])
    return record(request=request, reply=reply)


def snapshot(
    name,
    expect,
    completeness_applies=True,
    proof_applies=False,
    has_plan=True,
    na_justified=True,
    proofs=(),
    ci="green",
    hosted="clear",
    local="clear",
    completeness="none",
    proof="none"):
    """Return one frozen snapshot as a scenario.

    Nothing changes and the service says nothing more: the thread holds
    exactly the seeded requests and replies. `expect` is `ready` or `draft`.
    The assignment stops at readiness, so a snapshot answers one question:
    may this candidate leave draft? Arguments are literals only, so a test
    can read a snapshot table without evaluating it.
    """
    requests = []
    replies = []
    for kind, spec in (("completeness", completeness), ("proof", proof)):
        thread = seeded_thread(kind, spec, has_plan, proofs)
        if thread != None:
            if thread.reply != None:
                replies.append((len(requests), thread.reply))
            requests.append(thread.request)
    return scenario(
        name=name, completeness_applies=completeness_applies,
        proof_applies=proof_applies, has_plan=has_plan,
        na_justified=na_justified, proofs=proofs, authority="ready-only",
        reply_shapes=(), ci_outcomes=(ci,), hosted_outcomes=(hosted,),
        local_outcomes=("clear",) if local == "unavailable" else (local,),
        starts_in_outage=local == "unavailable",
        outage_recovers=local != "unavailable",
        seed_requests=tuple(requests), seed_replies=tuple(replies),
        expect_ready="unchecked" if expect == "ready" else "never",
        expect_merge="never",
        expect_progress="ready" if expect == "ready" else "unchecked")


action Init:
    # Only the choice is state; the scenario itself is a frozen global, so
    # it is not copied into every explored state.
    sc = oneof range(len(SCENARIOS))
    cfg = SCENARIOS[sc]

    # Reality: the remote candidate, the approved plan and the inventory.
    base = 0
    head = 0
    rev = 0
    widened = False
    changes = 0
    draft = not cfg.starts_ready
    merged = False
    ci = "pending"
    hosted = "pending"
    cs_up = not cfg.starts_in_outage
    outages = 0
    requests = list(cfg.seed_requests)
    replies = dict(cfg.seed_replies)
    foreign = {}

    # Observation: ephemeral agent state, lost when the agent is interrupted.
    pc = "start"
    obs = None
    cur = {}
    intent = None
    # What this pass's reply read and re-fetch returned, kept so that the
    # order properties compare reads, not flags the agent sets for itself.
    fresh = None
    recheck = None
    crashes = 0
    # History for one reachability witness only: an interruption that struck
    # while a posted question was still unanswered.
    interrupted_while_waiting = False

    # Evidence: the durable delivery ledger.
    l_checks = None
    l_local = None
    l_eval = {}
    l_claim = None
    l_impasse = None
    l_merged = False


# --------------------------------------------------------------------------
# Environment. Identity components only increase, and the shared change
# budget bounds them, so a superseded value can never become current again.
# --------------------------------------------------------------------------

atomic action HeadChanges:
    cfg = SCENARIOS[sc]
    require cfg.env_head and changes < cfg.change_budget and not merged
    head = head + 1
    changes = changes + 1
    ci = "pending"
    hosted = "pending"

atomic action BaseChanges:
    cfg = SCENARIOS[sc]
    require cfg.env_base and changes < cfg.change_budget and not merged
    base = base + 1
    changes = changes + 1
    ci = "pending"
    hosted = "pending"

atomic action PlanRevisionChanges:
    # A newly approved revision with no new head: base/head stay the same.
    cfg = SCENARIOS[sc]
    require cfg.env_plan and cfg.has_plan and changes < cfg.change_budget and not merged
    rev = rev + 1
    changes = changes + 1

atomic action InventoryChanges:
    cfg = SCENARIOS[sc]
    require cfg.env_inventory and cfg.wider_proofs != None and not widened
    require changes < cfg.change_budget and not merged
    widened = True
    changes = changes + 1

atomic fair action ChecksComplete:
    cfg = SCENARIOS[sc]
    require ci == "pending" or hosted == "pending"
    if ci == "pending":
        ci = oneof cfg.ci_outcomes
    if hosted == "pending":
        hosted = oneof cfg.hosted_outcomes

atomic action OutageBegins:
    cfg = SCENARIOS[sc]
    require cs_up and outages < cfg.outage_budget
    cs_up = False
    outages = outages + 1

atomic fair action OutageEnds:
    cfg = SCENARIOS[sc]
    require not cs_up and cfg.outage_recovers
    cs_up = True

atomic fair action ServiceReplies:
    # Replies may arrive late and out of order: any unanswered request, old
    # or current, may be answered at any time.
    cfg = SCENARIOS[sc]
    pending = [m for m in range(len(requests)) if m not in replies]
    require len(pending) > 0
    marker = oneof pending
    allowed = [s for s in cfg.reply_shapes if shape_allowed(cfg, requests[marker], s)]
    require len(allowed) > 0
    shape = oneof allowed
    replies[marker] = shaped_reply(requests[marker], shape)

atomic action ServiceEditsReply:
    # The service edits a reply in place, at most once per reply.
    cfg = SCENARIOS[sc]
    require cfg.env_edits
    editable = [m for m in replies if replies[m].edits == 0]
    require len(editable) > 0
    marker = oneof editable
    others = [s for s in cfg.reply_shapes if s != replies[marker].shape and shape_allowed(cfg, requests[marker], s)]
    require len(others) > 0
    shape = oneof others
    edited = shaped_reply(requests[marker], shape)
    replies[marker] = record(verdict=edited.verdict, subject=edited.subject,
                             base=edited.base, head=edited.head,
                             rev=edited.rev, proofs=edited.proofs,
                             shape=shape, edits=1)

atomic action OtherAuthorComments:
    # Somebody who is not the assessment service echoes a request marker and
    # says the work is clear.
    cfg = SCENARIOS[sc]
    require cfg.env_foreign
    silent = [m for m in range(len(requests)) if m not in foreign]
    require len(silent) > 0
    marker = oneof silent
    foreign[marker] = shaped_reply(requests[marker], "sound-clear")


# --------------------------------------------------------------------------
# Agent. One pass reads, asks, reads again and decides; a blocked pass starts
# over, which is the documented polling loop rather than a deadlock.
#
# What each step computes is a pure function of what the agent has read and
# recorded, so the step itself is a read, an assignment and at most one
# effect. The functions never see reality: they are handed observations.
# --------------------------------------------------------------------------

def plan_step(cfg, obs, seen_rev, seen_proofs, evals):
    """Fold the plan read into the observation and settle applicability.

    An applicable completeness assessment with no approved revision, an
    applicable proof assessment with no inventory, and an inapplicable
    assessment with no justification are scope errors: explicit impasses,
    not assessments to read as clear.
    """
    seen = record(base=obs.base, head=obs.head, draft=obs.draft, rev=seen_rev, proofs=seen_proofs)
    if cfg.completeness_applies and not cfg.has_plan:
        return record(obs=seen, evals=evals, impasse="completeness-without-approved-revision")
    if cfg.proof_applies and len(seen_proofs) == 0:
        return record(obs=seen, evals=evals, impasse="proof-inventory-empty")
    if not cfg.na_justified and not (cfg.completeness_applies and cfg.proof_applies):
        return record(obs=seen, evals=evals, impasse="not-applicable-undefended")
    recorded = dict(evals)
    for kind in KINDS:
        if not applies(cfg, kind):
            recorded[kind] = record(status="not-applicable", justified=True)
    return record(obs=seen, evals=recorded, impasse=None)


def delivery_gates_hold(obs, checks, local):
    """Green CI and clear hosted findings for the observed candidate, and a
    clean local delta of the same base/head comparison. An unavailable local
    result is not clean, and a hosted green check does not stand in for it."""
    return (checks != None and local != None
            and checks.base == obs.base and checks.head == obs.head
            and checks.ci == "green" and checks.hosted == "clear"
            and local.base == obs.base
            and local.tree == obs.head and local.value == "clear")


def adopt_requests(cfg, requests, obs):
    """Return the marker of each request already asking this exact question."""
    adopted = {}
    for kind in KINDS:
        if applies(cfg, kind):
            found = find_request(requests, question(kind, obs.base, obs.head, obs.rev, obs.proofs))
            if found != None:
                adopted[kind] = found
    return adopted


def unasked(cfg, cur):
    return [kind for kind in KINDS if applies(cfg, kind) and kind not in cur]


def read_replies(cfg, cur, requests, replies, evals):
    """Record, for each awaited request, what its thread says now.

    Only the assessment service's own comment answers a request, and only
    the comment correlated with this request's marker. No reply is recorded
    as pending, never as an answer.
    """
    recorded = dict(evals)
    for kind in KINDS:
        if applies(cfg, kind):
            marker = cur[kind]
            reply = replies.get(marker)
            if reply == None:
                recorded[kind] = record(status="pending", marker=marker, asked=requests[marker])
            else:
                recorded[kind] = record(status="reply", marker=marker,
                                        asked=requests[marker],
                                        verdict=reply.verdict,
                                        subject=reply.subject, base=reply.base,
                                        head=reply.head, rev=reply.rev,
                                        proofs=reply.proofs, edits=reply.edits)
    return recorded


def assessment_clears(cfg, kind, entry, marker, obs):
    """The agent's guard for one assessment, in the documented order."""
    if not applies(cfg, kind):
        return entry != None and entry.status == "not-applicable"
    if entry == None or entry.status != "reply":
        return False
    if entry.marker != marker:
        return False
    if entry.verdict != "clear":
        return False
    if entry.base != obs.base or entry.head != obs.head:
        return False
    if obs.rev != None and entry.rev != obs.rev:
        return False
    if kind == "completeness" and entry.subject != "whole":
        return False
    if kind == "proof" and not covers(obs.proofs, entry.proofs):
        return False
    return True


def eligible(cfg, obs, cur, checks, local, evals):
    return (delivery_gates_hold(obs, checks, local)
            and all([assessment_clears(cfg, kind, evals.get(kind), cur.get(kind), obs) for kind in KINDS]))


def next_step(cfg, obs, clears):
    """Where a decision leads, within the assignment's authority."""
    if not clears:
        return "start"
    if obs.draft:
        if cfg.authority == "stay-draft":
            return "done"
        return "ready-command"
    if cfg.authority == "merge":
        return "merge-command"
    return "done"


atomic fair action AgentObservesPullRequest:
    require pc == "start"
    # One `gh pr view`: base, head, draft and merged state together.
    fresh = None
    recheck = None
    cur = {}
    intent = None
    obs = record(base=base, head=head, draft=draft, rev=None, proofs=())
    l_merged = merged
    pc = "done" if merged else "plan"

atomic fair action AgentObservesPlanAndInventory:
    require pc == "plan"
    cfg = SCENARIOS[sc]
    step = plan_step(cfg, obs, rev if cfg.has_plan else None, cfg.wider_proofs if widened else cfg.proofs, l_eval)
    obs = step.obs
    l_eval = step.evals
    l_impasse = step.impasse
    pc = "checks" if step.impasse == None else "impasse"

atomic fair action AgentReadsChecks:
    require pc == "checks"
    # One check-rollup read. It reports the head it concerns, so the record
    # is bound to the candidate that was actually published at the read.
    l_checks = record(base=base, head=head, ci=ci, hosted=hosted)
    pc = "local"

atomic fair action AgentRunsLocalDelta:
    require pc == "local"
    cfg = SCENARIOS[sc]
    # The agent runs `cs delta` between the observed base and its own
    # checkout of the observed head. A recorded clean result is reused only
    # for that comparison.
    if not (l_local != None and l_local.base == obs.base and l_local.tree == obs.head and l_local.value == "clear"):
        value = "unavailable"
        if cs_up:
            value = oneof cfg.local_outcomes
        l_local = record(base=obs.base, tree=obs.head, value=value)
    pc = "inspect" if delivery_gates_hold(obs, l_checks, l_local) else "start"

atomic fair action AgentInspectsDiscussion:
    require pc == "inspect"
    cfg = SCENARIOS[sc]
    # Re-entry and read-back are the same read: adopt the request already
    # asking this exact question instead of asking it again.
    cur = adopt_requests(cfg, requests, obs)
    pc = "post" if len(unasked(cfg, cur)) > 0 else "read"

atomic fair action AgentPostsRequest:
    require pc == "post"
    cfg = SCENARIOS[sc]
    requests.append(question(unasked(cfg, cur)[0], obs.base, obs.head, obs.rev, obs.proofs))
    # The effect is remote. The agent learns the marker only by reading the
    # discussion back, so an interruption here loses nothing durable.
    pc = "inspect"

atomic fair action AgentReadsReplies:
    require pc == "read"
    l_eval = read_replies(SCENARIOS[sc], cur, requests, replies, l_eval)
    fresh = {kind: record(marker=cur[kind], reply=replies.get(cur[kind])) for kind in cur}
    pc = "recheck"

atomic fair action AgentRechecksCandidate:
    require pc == "recheck"
    # Re-fetch live base/head before accepting a result. This narrows the
    # window in which the candidate can move; it cannot close it.
    recheck = record(base=base, head=head, draft=draft, merged=merged)
    pc = "decide" if recheck.base == obs.base and recheck.head == obs.head and recheck.draft == obs.draft and not recheck.merged else "start"

atomic fair action AgentDecides:
    require pc == "decide"
    cfg = SCENARIOS[sc]
    pc = next_step(cfg, obs, eligible(cfg, obs, cur, l_checks, l_local, l_eval))
    if pc in ("ready-command", "merge-command"):
        intent = record(base=obs.base, head=obs.head)
    if pc != "start" and not obs.draft and l_claim == None:
        l_claim = record(kind="observed-ready", base=obs.base, head=obs.head)

atomic fair action AgentRunsReadyCommand:
    require pc == "ready-command"
    # `gh pr ready` takes no expected head: it marks whatever is published.
    draft = False
    pc = "ready-readback"

atomic fair action AgentReadsBackReady:
    require pc == "ready-readback"
    verified = not draft and base == intent.base and head == intent.head
    l_claim = record(kind="verified-transition" if verified else "observed-ready", base=base, head=head)
    pc = "done" if SCENARIOS[sc].authority == "ready-only" else "start"

atomic fair action AgentRunsMergeCommand:
    require pc == "merge-command"
    # `gh pr merge --match-head-commit` refuses a head other than the one
    # named. It guards the head only: not the base, the plan or a reply.
    merged = head == intent.head and not draft
    pc = "start"

atomic action AgentInterrupted:
    # A crash, a lost command response, or the end of a session. Everything
    # the agent held in memory is gone; the ledger and the remote remain.
    require crashes < SCENARIOS[sc].crash_budget and pc not in TERMINAL
    crashes = crashes + 1
    interrupted_while_waiting = interrupted_while_waiting or len(requests) > len(replies)
    pc = "start"
    obs = None
    cur = {}
    intent = None
    fresh = None
    recheck = None

atomic action Settled:
    # The legitimate terminal states: the assignment reached its authorized
    # stopping point, or recorded an explicit impasse. Enabled nowhere else,
    # so deadlock detection still reports any other stuck state.
    require pc in TERMINAL
    pass


# --------------------------------------------------------------------------
# Properties. Each is written from the contract, not from the agent's guard:
# the guard correlates by request marker and walks one chain of conditions,
# while these compare the recorded evidence with a named identity and list
# every reason it falls short. No property calls a predicate the agent uses
# to decide, so a defective guard cannot move its own oracle.
# --------------------------------------------------------------------------

def shortfalls(cfg, ident, checks, local, evals):
    """List every reason the evidence does not clear `ident` to leave draft.

    `ident` is the candidate under judgement: base, head, plan revision when
    an ExecPlan applies, and required proof inventory.
    """
    found = []
    if checks == None:
        found.append("checks-unread")
    else:
        if checks.base != ident.base or checks.head != ident.head:
            found.append("checks-for-another-candidate")
        if checks.ci != "green":
            found.append("ci-not-green")
        if checks.hosted != "clear":
            found.append("hosted-codescene-not-clear")
    if local == None:
        found.append("local-codescene-unread")
    else:
        if local.base != ident.base or local.tree != ident.head:
            found.append("local-codescene-for-another-comparison")
        if local.value != "clear":
            found.append("local-codescene-" + local.value)
    for kind in KINDS:
        entry = evals.get(kind)
        wanted = (kind == "completeness" and cfg.completeness_applies) or (kind == "proof" and cfg.proof_applies)
        if not wanted:
            if entry == None or entry.status != "not-applicable" or not cfg.na_justified:
                found.append(kind + "-not-applicable-unrecorded")
            continue
        if kind == "completeness" and not cfg.has_plan:
            found.append("completeness-without-approved-revision")
        if kind == "proof" and len(ident.proofs) == 0:
            found.append("proof-inventory-empty")
        if entry == None:
            found.append(kind + "-unasked")
            continue
        if entry.status == "pending":
            found.append(kind + "-pending")
            continue
        if entry.status != "reply":
            found.append(kind + "-reply-exempts-itself")
            continue
        asked = entry.asked
        if asked.kind != kind:
            found.append(kind + "-answer-to-another-kind")
        if asked.base != ident.base or asked.head != ident.head:
            found.append(kind + "-request-for-another-candidate")
        if asked.rev != ident.rev:
            found.append(kind + "-request-for-another-revision")
        if kind == "proof" and asked.proofs != ident.proofs:
            found.append(kind + "-request-for-another-inventory")
        if entry.verdict == "not-applicable":
            found.append(kind + "-reply-exempts-itself")
        elif entry.verdict != "clear":
            found.append(kind + "-" + entry.verdict)
        if entry.base != ident.base or entry.head != ident.head:
            found.append(kind + "-verdict-for-another-candidate")
        if ident.rev != None and entry.rev != ident.rev:
            found.append(kind + "-revision-not-echoed")
        if kind == "completeness" and entry.subject != "whole":
            found.append("completeness-subject-" + entry.subject)
        if kind == "proof":
            for proof in ident.proofs:
                if proof not in entry.proofs:
                    found.append("proof-uncovered-" + proof)
    return found


def observed_identity(obs):
    return record(base=obs.base, head=obs.head, rev=obs.rev, proofs=obs.proofs)


def real_identity(cfg, state):
    """The candidate as it actually stands, whatever the agent has read."""
    plan = None
    if cfg.has_plan:
        plan = state.rev
    inventory = cfg.proofs
    if state.widened:
        inventory = cfg.wider_proofs
    return record(base=state.base, head=state.head, rev=plan, proofs=inventory)


def ledger_matches_thread(state):
    """Whether every recorded reply is still what the thread says."""
    for kind in KINDS:
        entry = state.l_eval.get(kind)
        if entry == None or entry.status != "reply":
            continue
        live = state.replies.get(entry.marker)
        if live == None or live.edits != entry.edits or live.verdict != entry.verdict:
            return False
    return True


# PRR-ELIG-01, PRR-APPL-01..04, PRR-BIND-01..04, PRR-DELIV-01..03.
transition assertion ReadyNeedsCurrentEvidence(before, after):
    cfg = SCENARIOS[before.sc]
    if not (before.draft and not after.draft):
        return True
    if before.obs == None:
        return False
    return len(shortfalls(cfg, observed_identity(before.obs), before.l_checks, before.l_local, before.l_eval)) == 0

# PRR-AUTH-01.
transition assertion ReadyRespectsAuthority(before, after):
    cfg = SCENARIOS[before.sc]
    if before.draft and not after.draft:
        return cfg.authority != "stay-draft"
    return True

def reads_are_fresh(state, cfg):
    """Whether a command rests on this pass's own reads, in the stated order.

    The reply read and the re-fetch each leave what they returned. The
    ledger must hold exactly what the reply read returned for every
    applicable assessment, and the re-fetch must have returned the candidate
    the pass observed, still unmerged. Neither is a flag: a pass that kept an
    old ledger entry, or that went on without comparing, fails here.
    """
    if state.obs == None or state.intent == None or state.fresh == None or state.recheck == None:
        return False
    if state.intent.base != state.obs.base or state.intent.head != state.obs.head:
        return False
    seen = state.recheck
    if seen.base != state.obs.base or seen.head != state.obs.head or seen.draft != state.obs.draft or seen.merged:
        return False
    for kind in KINDS:
        wanted = (kind == "completeness" and cfg.completeness_applies) or (kind == "proof" and cfg.proof_applies)
        if not wanted:
            continue
        read = state.fresh.get(kind)
        entry = state.l_eval.get(kind)
        if read == None or entry == None or entry.status == "not-applicable" or entry.marker != read.marker:
            return False
        if read.reply == None:
            if entry.status != "pending":
                return False
        elif entry.status != "reply" or entry.edits != read.reply.edits or entry.verdict != read.reply.verdict:
            return False
    return True


# PRR-ORDER-01: replies are read, then the candidate is re-fetched, in the
# same uninterrupted pass that issues the ready command.
transition assertion ReadyFollowsFreshReads(before, after):
    cfg = SCENARIOS[before.sc]
    if before.draft and not after.draft:
        return reads_are_fresh(before, cfg)
    return True

# PRR-ORDER-01, PRR-LIFE-03: the same holds immediately before a merge.
transition assertion MergeFollowsFreshReads(before, after):
    cfg = SCENARIOS[before.sc]
    if after.merged and not before.merged:
        return reads_are_fresh(before, cfg)
    return True

# PRR-LIFE-01.
transition assertion NeverReturnsToDraft(before, after):
    cfg = SCENARIOS[before.sc]
    if not before.draft:
        return not after.draft
    return True

# PRR-LIFE-03, PRR-AUTH-02. The head comparison is against the real head: it
# holds because the merge command is conditional on the head it names.
transition assertion MergeNeedsAuthorityAndRenewedEvidence(before, after):
    cfg = SCENARIOS[before.sc]
    if not (after.merged and not before.merged):
        return True
    if cfg.authority != "merge" or before.draft:
        return False
    if before.obs == None or before.intent == None:
        return False
    if before.head != before.intent.head or before.obs.head != before.intent.head:
        return False
    return len(shortfalls(cfg, observed_identity(before.obs), before.l_checks, before.l_local, before.l_eval)) == 0

# PRR-REQ-01: a question is posted only for an applicable assessment, about
# the observed candidate, after its delivery gates hold.
transition assertion RequestNeedsDeliveryGates(before, after):
    cfg = SCENARIOS[before.sc]
    if len(after.requests) == len(before.requests):
        return True
    posted = after.requests[len(before.requests)]
    seen = before.obs
    if seen == None or before.l_checks == None or before.l_local == None:
        return False
    if posted.kind == "completeness" and not cfg.completeness_applies:
        return False
    if posted.kind == "proof" and (not cfg.proof_applies or len(posted.proofs) == 0):
        return False
    if posted.base != seen.base or posted.head != seen.head or posted.rev != seen.rev:
        return False
    return (before.l_checks.base == seen.base and before.l_checks.head == seen.head
            and before.l_checks.ci == "green" and before.l_checks.hosted == "clear"
            and before.l_local.base == seen.base
            and before.l_local.tree == seen.head and before.l_local.value == "clear")

# PRR-REQ-02: an unanswered question is preserved, not asked again. The
# contract forbids repeating a request that is still unanswered; whether an
# answered one may be followed up is outside this model, whose agent never
# does (see README.md, "Assumptions and bounds").
transition assertion RequestIsNotRepeated(before, after):
    if len(after.requests) == len(before.requests):
        return True
    posted = after.requests[len(before.requests)]
    for marker in range(len(before.requests)):
        earlier = before.requests[marker]
        if (marker not in before.replies
                and earlier.kind == posted.kind and earlier.base == posted.base
                and earlier.head == posted.head and earlier.rev == posted.rev
                and earlier.proofs == posted.proofs):
            return False
    return True

# PRR-HON-01: the ledger records what the thread said, from the service, for
# the request it names. A missing reply is recorded as pending.
transition assertion EvidenceIsWhatWasRead(before, after):
    cfg = SCENARIOS[before.sc]
    for kind in KINDS:
        entry = after.l_eval.get(kind)
        if entry == None or entry == before.l_eval.get(kind):
            continue
        if entry.status == "not-applicable":
            if (kind == "completeness" and cfg.completeness_applies) or (kind == "proof" and cfg.proof_applies):
                return False
            continue
        if entry.marker >= len(before.requests) or before.requests[entry.marker] != entry.asked:
            return False
        live = before.replies.get(entry.marker)
        if entry.status == "pending":
            if live != None:
                return False
            continue
        if live == None:
            return False
        if (live.verdict != entry.verdict or live.subject != entry.subject
                or live.base != entry.base or live.head != entry.head
                or live.rev != entry.rev or live.proofs != entry.proofs
                or live.edits != entry.edits):
            return False
    return True

# PRR-HON-02: an unevaluable local source is recorded as unavailable.
transition assertion LocalResultIsWhatWasRun(before, after):
    cfg = SCENARIOS[before.sc]
    if after.l_local == before.l_local or after.l_local == None:
        return True
    if before.obs == None or after.l_local.tree != before.obs.head or after.l_local.base != before.obs.base:
        return False
    if not before.cs_up:
        return after.l_local.value == "unavailable"
    return after.l_local.value != "unavailable"

# PRR-HON-03: observations and check records are copies of what was there.
transition assertion ObservationsRecordReality(before, after):
    cfg = SCENARIOS[before.sc]
    if after.recheck != before.recheck and after.recheck != None:
        if (after.recheck.base != before.base or after.recheck.head != before.head
                or after.recheck.draft != before.draft or after.recheck.merged != before.merged):
            return False
    if after.fresh != before.fresh and after.fresh != None:
        for kind in after.fresh:
            read = after.fresh[kind]
            if read.reply != before.replies.get(read.marker):
                return False
    if after.l_checks != before.l_checks and after.l_checks != None:
        if (after.l_checks.base != before.base or after.l_checks.head != before.head
                or after.l_checks.ci != before.ci or after.l_checks.hosted != before.hosted):
            return False
    if after.obs != before.obs and after.obs != None:
        real = real_identity(cfg, before)
        if before.pc == "start":
            # The pull-request read: base, head and draft state.
            return (after.obs.base == real.base and after.obs.head == real.head
                    and after.obs.draft == before.draft)
        # The plan read: it adds the revision and inventory and must leave
        # the earlier pull-request observation as it was read.
        return (before.obs != None and after.obs.base == before.obs.base
                and after.obs.head == before.obs.head
                and after.obs.draft == before.obs.draft
                and after.obs.rev == real.rev and after.obs.proofs == real.proofs)
    return True

# PRR-HON-04: a readiness claim is either a read-back or an observation, and
# says which. Only a read-back of the candidate the command was issued for
# is a verified transition; an already-ready PR is recorded as observed.
transition assertion VerifiedClaimNeedsMatchingReadBack(before, after):
    cfg = SCENARIOS[before.sc]
    if after.l_claim == before.l_claim or after.l_claim == None:
        return True
    claim = after.l_claim
    read_back = (before.pc == "ready-readback" and not before.draft
                 and claim.base == before.base and claim.head == before.head)
    if claim.kind == "verified-transition":
        return (read_back and before.intent != None
                and before.intent.base == before.base
                and before.intent.head == before.head)
    if read_back:
        return True
    return (before.obs != None and not before.obs.draft
            and claim.base == before.obs.base and claim.head == before.obs.head)

# PRR-HON-05.
always assertion ClaimsNeverOutrunTheRemote:
    cfg = SCENARIOS[sc]
    if l_claim != None and draft:
        return False
    if l_merged and not merged:
        return False
    return (pc == "impasse") == (l_impasse != None)

# PRR-HON-06: an impasse is a recorded reason and never a transition.
always assertion ImpasseLeavesTheDraftAlone:
    cfg = SCENARIOS[sc]
    if l_impasse == None or cfg.starts_ready:
        return True
    return draft and not merged

# Declared outcome of each configuration: blocked assignments.
always assertion BlockedAssignmentStaysDraft:
    cfg = SCENARIOS[sc]
    return cfg.expect_ready != "never" or draft

always assertion UnauthorizedOrBlockedMergeNeverHappens:
    cfg = SCENARIOS[sc]
    return cfg.expect_merge != "never" or not merged

# Declared outcome of each configuration: permitted assignments. Each is
# trivially true in a configuration that does not declare it, and the suite
# manifest records which configuration declares which.
exists assertion ReadyIsReachable:
    cfg = SCENARIOS[sc]
    return cfg.expect_ready != "reachable" or (l_claim != None and l_claim.kind == "verified-transition")

exists assertion MergeIsReachable:
    cfg = SCENARIOS[sc]
    return cfg.expect_merge != "reachable" or (merged and l_merged)

# PRR-LIFE-02: recovery after invalidation. More questions on the thread
# than assessments means a question was asked, invalidated by a change, and
# asked again for the candidate that then reached its outcome.
exists assertion RecoveryIsReachable:
    cfg = SCENARIOS[sc]
    asked = (1 if cfg.completeness_applies else 0) + (1 if cfg.proof_applies else 0)
    if cfg.expect_recovery == "merged":
        return changes >= 1 and merged and len(requests) > asked
    if cfg.expect_recovery == "ready":
        return (changes >= 1 and len(requests) > asked and l_claim != None
                and l_claim.kind == "verified-transition"
                and l_claim.base == base and l_claim.head == head)
    return True

# PRR-LIFE-02: a ready PR stays ready while its evidence is out of date.
exists assertion StaleReadyIsReachable:
    cfg = SCENARIOS[sc]
    if cfg.expect_stale_ready != "reachable":
        return True
    return (not draft and not merged and l_claim != None
            and (l_claim.base != base or l_claim.head != head))

# PRR-REQ-03: an interruption strikes while a posted question is still
# unanswered; the question is adopted on re-entry, its late reply consumed,
# and no replacement posted.
exists assertion ReentryConsumesDelayedReply:
    cfg = SCENARIOS[sc]
    if cfg.expect_reentry != "reachable":
        return True
    asked = (1 if cfg.completeness_applies else 0) + (1 if cfg.proof_applies else 0)
    return interrupted_while_waiting and not draft and len(requests) == asked

# PRR-PROG-01: conditional progress. The conditions are the configuration's
# own: a bounded change budget (eventual candidate stability), recovering
# outages, a service that eventually answers, and weakly fair agent steps.
eventually always assertion ProgressWhenWarranted:
    cfg = SCENARIOS[sc]
    if cfg.expect_progress == "ready":
        return not draft
    if cfg.expect_progress == "merged":
        return merged
    if cfg.expect_progress == "impasse":
        return pc == "impasse"
    return True

# --------------------------------------------------------------------------
# Strong properties. These state what an ideal atomic policy transition
# would guarantee: the evidence is current in reality when the command takes
# effect. The documented protocol cannot guarantee them, because neither
# `gh pr ready` nor a head-only merge guard is conditional on everything the
# evidence is bound to. They are evaluated only where `check_strong` is set:
# under a frozen environment, where they hold, and in the configurations
# named `expected-counterexample-*`, where they are required to fail.
# --------------------------------------------------------------------------

transition assertion StrongReadyFreshness(before, after):
    cfg = SCENARIOS[before.sc]
    if not cfg.check_strong or not (before.draft and not after.draft):
        return True
    if not ledger_matches_thread(before) or before.ci != "green" or before.hosted != "clear":
        return False
    return len(shortfalls(cfg, real_identity(cfg, before), before.l_checks, before.l_local, before.l_eval)) == 0

transition assertion StrongMergeFreshness(before, after):
    cfg = SCENARIOS[before.sc]
    if not cfg.check_strong or not (after.merged and not before.merged):
        return True
    if not ledger_matches_thread(before) or before.ci != "green" or before.hosted != "clear":
        return False
    return len(shortfalls(cfg, real_identity(cfg, before), before.l_checks, before.l_local, before.l_eval)) == 0
